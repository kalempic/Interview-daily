# Firebase web app config. Copy this file to .env and fill in the values
# from Firebase console → Project settings → Your apps → SDK setup.
# All of these are safe to expose in a web app. Protect data with Firestore rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
